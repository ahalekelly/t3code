<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- CarConnection reads Android Auto's connection state from this provider. -->
    <provider android:authorities="androidx.car.app.connection" />
  </queries>
  <application>
    <service android:name=".SpeechService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    <service android:name=".BackgroundTaskService" android:exported="false" android:foregroundServiceType="shortService" />
  </application>
</manifest>
