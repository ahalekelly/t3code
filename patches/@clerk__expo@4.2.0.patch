+
+  /// `ClerkRedirectUrl` in Info.plist overrides the SDK's `{bundleIdentifier}://callback`
+  /// default for builds whose bundle identifier is not an authorized Clerk redirect.
+  private static func redirectConfigFromInfoPlist() -> Clerk.Options.RedirectConfig? {
+    guard let redirectUrl = Bundle.main.object(forInfoDictionaryKey: "ClerkRedirectUrl") as? String else {
